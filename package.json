{
  "name": "qubetics_wallet_processes",
  "version": "1.0.0",
  "description": "Process for qubetics wallet eth blockchain",
  "main": "index.eth.ts",
  "scripts": {
    "compile": "tsc",
    "server": "nodemon --max-old-space-size=20480 build/index.eth.js",
    "dev": "concurrently \"npm run compile\" \"npm run server\"",
    "start": "npm run compile && node build/index.eth.js",
    "test": "tsc && node --test test/*.test.js"
  },
  "keywords": [
    "processes"
  ],
  "author": "Qubetics",
  "license": "ISC",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bignumber.js": "^11.1.5",
    "dotenv": "^18.0.8",
    "ethers": "^6.17.0",
    "firebase-admin": "^14.5.0",
    "kafkajs": "^2.2.4",
    "mysql2": "^3.24.6",
    "node-schedule": "^2.1.1",
    "node-zookeeper-client": "^1.1.3",
    "redis": "^6.3.0",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/node-schedule": "^2.1.8",
    "@types/node-zookeeper-client": "^1.1.0",
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  }
}
